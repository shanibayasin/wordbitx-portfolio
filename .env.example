# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# JWT_SECRET: Required in production. Use at least 32 random bytes.
# Example: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES"

# PUBLIC_LEAD_ALLOWED_ORIGINS: Comma-separated browser origins allowed to call the API.
# Set this to the exact deployed frontend origin(s); avoid * in production.
PUBLIC_LEAD_ALLOWED_ORIGINS="http://localhost:3000"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
